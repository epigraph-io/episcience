# migrations/5032_legacy_baseline.fingerprint
#
# The canonical fingerprint of the 14 EpiScience tables as
# 5032_legacy_baseline.sql creates them on a kernel-schema database:
# tables, columns (position among non-dropped columns, type, nullability,
# default), constraint names and kinds, index names, trigger names. One line
# each, sorted bytewise. Produced by episcience_db::ledger::fingerprint, whose
# rendering pins search_path = pg_catalog so non-catalog names are qualified.
#
# `episcience-migrate adopt-baseline` recomputes this from a LIVE legacy
# database and records 5032 only on an exact match. On a mismatch it prints
# the diff: fix the baseline DDL (a fresh database must equal the deployed
# one), NEVER edit this file to match a live database.
# The test `ledger_baseline_test` pins this file to what 5032 builds.
#
# One deliberate difference from replaying migrations/legacy/: the kernel's
# tenancy-column migration (062) refuses any public `visibility` column that is
# not `character varying`, so legacy databases carry
# `syntheses.visibility character varying(16)`; 5032 creates that shape.
column blobs.content_hash #5 bytea not-null default=-
column blobs.created_at #10 timestamp with time zone not-null default=now()
column blobs.filename #2 text not-null default=-
column blobs.id #1 uuid not-null default=gen_random_uuid()
column blobs.labels #8 text[] not-null default='{}'::text[]
column blobs.mime_type #3 character varying(255) not-null default=-
column blobs.properties #9 jsonb not-null default='{}'::jsonb
column blobs.sample_id #7 uuid nullable default=-
column blobs.size_bytes #4 bigint not-null default=-
column blobs.uploader_id #6 uuid not-null default=-
column countersignatures.claim_id #2 uuid not-null default=-
column countersignatures.content_hash #5 bytea not-null default=-
column countersignatures.created_at #7 timestamp with time zone not-null default=now()
column countersignatures.id #1 uuid not-null default=gen_random_uuid()
column countersignatures.prev_signature_hash #8 bytea nullable default=-
column countersignatures.signature #6 bytea not-null default=-
column countersignatures.signature_meaning #4 character varying(50) not-null default=-
column countersignatures.signature_version #9 smallint not-null default=1
column countersignatures.signer_id #3 uuid not-null default=-
column episcience_worker_state.last_event_id #2 text nullable default=-
column episcience_worker_state.last_event_ts #3 timestamp with time zone nullable default=-
column episcience_worker_state.updated_at #4 timestamp with time zone not-null default=now()
column episcience_worker_state.worker_id #1 text not-null default=-
column protocols.authored_by #4 uuid not-null default=-
column protocols.content_hash #11 bytea not-null default=-
column protocols.created_at #12 timestamp with time zone not-null default=now()
column protocols.equipment #6 text[] nullable default='{}'::text[]
column protocols.id #1 uuid not-null default=gen_random_uuid()
column protocols.labels #9 text[] not-null default='{}'::text[]
column protocols.properties #10 jsonb not-null default='{}'::jsonb
column protocols.safety_notes #7 text nullable default=-
column protocols.sections #14 jsonb not-null default='{}'::jsonb
column protocols.steps #5 jsonb not-null default='[]'::jsonb
column protocols.supersedes #8 uuid nullable default=-
column protocols.title #2 text not-null default=-
column protocols.updated_at #13 timestamp with time zone not-null default=now()
column protocols.version #3 integer not-null default=1
column sample_claims.claim_id #2 uuid not-null default=-
column sample_claims.created_at #4 timestamp with time zone not-null default=now()
column sample_claims.relationship #3 character varying(30) not-null default='observation'::character varying
column sample_claims.sample_id #1 uuid not-null default=-
column samples.content_hash #15 bytea not-null default=-
column samples.created_at #16 timestamp with time zone not-null default=now()
