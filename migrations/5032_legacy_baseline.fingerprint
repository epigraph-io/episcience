constraint blobs.blobs_content_hash_length c CHECK ((octet_length(content_hash) = 32))
constraint blobs.blobs_filename_not_empty c CHECK ((length(TRIM(BOTH FROM filename)) > 0))
constraint blobs.blobs_pkey p PRIMARY KEY (id)
constraint blobs.blobs_sample_id_fkey f FOREIGN KEY (sample_id) REFERENCES samples(id) ON DELETE SET NULL
constraint blobs.blobs_size_positive c CHECK ((size_bytes > 0))
constraint blobs.blobs_uploader_id_fkey f FOREIGN KEY (uploader_id) REFERENCES agents(id) ON DELETE RESTRICT
constraint countersignatures.countersignatures_claim_id_fkey f FOREIGN KEY (claim_id) REFERENCES claims(id) ON DELETE RESTRICT
constraint countersignatures.countersignatures_pkey p PRIMARY KEY (id)
constraint countersignatures.countersignatures_signature_meaning_check c CHECK (((signature_meaning)::text = ANY ((ARRAY['witnessed'::character varying, 'approved'::character varying, 'reviewed'::character varying, 'certified'::character varying, 'countersigned'::character varying])::text[])))
constraint countersignatures.countersignatures_signer_id_fkey f FOREIGN KEY (signer_id) REFERENCES agents(id) ON DELETE RESTRICT
constraint countersignatures.cs_content_hash_length c CHECK ((octet_length(content_hash) = 32))
constraint countersignatures.cs_prev_hash_length c CHECK (((prev_signature_hash IS NULL) OR (octet_length(prev_signature_hash) = 32)))
constraint countersignatures.cs_signature_length c CHECK ((octet_length(signature) = 64))
constraint countersignatures.cs_unique_signer_claim u UNIQUE (claim_id, signer_id, signature_meaning)
constraint episcience_worker_state.episcience_worker_state_pkey p PRIMARY KEY (worker_id)
constraint protocols.protocols_authored_by_fkey f FOREIGN KEY (authored_by) REFERENCES agents(id) ON DELETE RESTRICT
constraint protocols.protocols_content_hash_length c CHECK ((octet_length(content_hash) = 32))
constraint protocols.protocols_pkey p PRIMARY KEY (id)
constraint protocols.protocols_root_version_is_one c CHECK (((supersedes IS NOT NULL) OR (version = 1)))
constraint protocols.protocols_supersedes_fkey f FOREIGN KEY (supersedes) REFERENCES protocols(id)
constraint protocols.protocols_title_not_empty c CHECK ((length(TRIM(BOTH FROM title)) > 0))
constraint sample_claims.sample_claims_claim_id_fkey f FOREIGN KEY (claim_id) REFERENCES claims(id) ON DELETE CASCADE
constraint sample_claims.sample_claims_pkey p PRIMARY KEY (sample_id, claim_id)
constraint sample_claims.sample_claims_relationship_check c CHECK (((relationship)::text = ANY ((ARRAY['observation'::character varying, 'measurement'::character varying, 'characterization'::character varying, 'preparation_note'::character varying])::text[])))
constraint sample_claims.sample_claims_sample_id_fkey f FOREIGN KEY (sample_id) REFERENCES samples(id) ON DELETE CASCADE
constraint samples.samples_content_hash_length c CHECK ((octet_length(content_hash) = 32))
constraint samples.samples_name_not_empty c CHECK ((length(TRIM(BOTH FROM name)) > 0))
constraint samples.samples_parent_sample_id_fkey f FOREIGN KEY (parent_sample_id) REFERENCES samples(id) ON DELETE RESTRICT
constraint samples.samples_pkey p PRIMARY KEY (id)
constraint samples.samples_prepared_by_fkey f FOREIGN KEY (prepared_by) REFERENCES agents(id) ON DELETE RESTRICT
constraint samples.samples_quantity_pair c CHECK (((quantity_value IS NULL) = (quantity_unit IS NULL)))
constraint samples.samples_sample_type_check c CHECK (((sample_type)::text = ANY ((ARRAY['biological'::character varying, 'chemical'::character varying, 'material'::character varying, 'composite'::character varying, 'workflow_run'::character varying])::text[])))
constraint samples.samples_status_check c CHECK (((status)::text = ANY ((ARRAY['prepared'::character varying, 'in_use'::character varying, 'consumed'::character varying, 'disposed'::character varying, 'archived'::character varying])::text[])))
constraint syntheses.syntheses_autonomy_level_check c CHECK ((autonomy_level = ANY (ARRAY['co_pilot'::text, 'autopilot'::text, 'autonomous'::text])))
constraint syntheses.syntheses_check c CHECK (((status = 'complete'::text) = (narrative IS NOT NULL)))
constraint syntheses.syntheses_check1 c CHECK (((status = 'complete'::text) = (completed_at IS NOT NULL)))
constraint syntheses.syntheses_check2 c CHECK (((stale_since IS NULL) = (stale_reason IS NULL)))
constraint syntheses.syntheses_clustering_method_check c CHECK ((clustering_method = 'signed_louvain'::text))
constraint syntheses.syntheses_content_hash_check c CHECK ((octet_length(content_hash) = 32))
constraint syntheses.syntheses_narrative_format_check c CHECK (((narrative_format IS NULL) OR (narrative_format = 'markdown'::text)))
constraint syntheses.syntheses_parent_synthesis_id_fkey f FOREIGN KEY (parent_synthesis_id) REFERENCES syntheses(id)
constraint syntheses.syntheses_pkey p PRIMARY KEY (id)
constraint syntheses.syntheses_skill_name_known c CHECK ((skill_name = ANY (ARRAY['baseline'::text, 'lab_notebook'::text, 'literature'::text, 'code_review'::text, 'registry_diff'::text])))
constraint syntheses.syntheses_stale_reason_check c CHECK (((stale_reason IS NULL) OR (stale_reason = ANY (ARRAY['belief_drift'::text, 'new_contradiction'::text, 'claim_superseded'::text, 'frame_changed'::text, 'edge_revoked'::text]))))
constraint syntheses.syntheses_status_check c CHECK ((status = ANY (ARRAY['pending'::text, 'running'::text, 'verifying'::text, 'complete'::text, 'failed'::text, 'deleted'::text, 'rejected'::text])))
constraint syntheses.syntheses_visibility_check c CHECK (((visibility)::text = ANY (ARRAY['private'::text, 'shared'::text, 'public'::text])))
constraint synthesis_claim_membership.synthesis_claim_membership_pkey p PRIMARY KEY (synthesis_id, claim_id)
constraint synthesis_claim_membership.synthesis_claim_membership_synthesis_id_fkey f FOREIGN KEY (synthesis_id) REFERENCES syntheses(id) ON DELETE CASCADE
constraint synthesis_clusters.synthesis_clusters_check c CHECK (((support_count >= 0) AND (contradict_count >= 0)))
constraint synthesis_clusters.synthesis_clusters_member_claim_ids_check c CHECK ((cardinality(member_claim_ids) > 0))
constraint synthesis_clusters.synthesis_clusters_pkey p PRIMARY KEY (id)
constraint synthesis_clusters.synthesis_clusters_synthesis_id_cluster_index_key u UNIQUE (synthesis_id, cluster_index)
constraint synthesis_clusters.synthesis_clusters_synthesis_id_fkey f FOREIGN KEY (synthesis_id) REFERENCES syntheses(id) ON DELETE CASCADE
constraint synthesis_clusters.synthesis_clusters_title_check c CHECK ((length(title) <= 200))
constraint synthesis_embeddings.synthesis_embeddings_embedding_input_check c CHECK ((embedding_input = ANY (ARRAY['narrative_head'::text, 'title_plus_query'::text, 'summary_concat'::text])))
constraint synthesis_embeddings.synthesis_embeddings_pkey p PRIMARY KEY (synthesis_id)
constraint synthesis_embeddings.synthesis_embeddings_synthesis_id_fkey f FOREIGN KEY (synthesis_id) REFERENCES syntheses(id) ON DELETE CASCADE
constraint synthesis_jobs.synthesis_jobs_id_fkey f FOREIGN KEY (id) REFERENCES syntheses(id) ON DELETE CASCADE
constraint synthesis_jobs.synthesis_jobs_pkey p PRIMARY KEY (id)
constraint synthesis_jobs.synthesis_jobs_state_check c CHECK ((state = ANY (ARRAY['queued'::text, 'running'::text, 'complete'::text, 'failed'::text, 'retry'::text])))
constraint synthesis_provo_edges.synthesis_provo_edges_pkey p PRIMARY KEY (synthesis_id, predicate, target_kind, target_id)
constraint synthesis_provo_edges.synthesis_provo_edges_predicate_check c CHECK ((predicate = ANY (ARRAY['WAS_DERIVED_FROM'::text, 'REFINES'::text, 'COMPOSED_OF'::text, 'ATTRIBUTED_TO'::text])))
constraint synthesis_provo_edges.synthesis_provo_edges_synthesis_id_fkey f FOREIGN KEY (synthesis_id) REFERENCES syntheses(id) ON DELETE CASCADE
constraint synthesis_provo_edges.synthesis_provo_edges_target_kind_check c CHECK ((target_kind = ANY (ARRAY['claim'::text, 'synthesis'::text, 'agent'::text, 'workflow'::text])))
constraint synthesis_shares.synthesis_shares_permission_check c CHECK ((permission = 'read'::text))
constraint synthesis_shares.synthesis_shares_pkey p PRIMARY KEY (synthesis_id, shared_with_agent_id)
constraint synthesis_shares.synthesis_shares_synthesis_id_fkey f FOREIGN KEY (synthesis_id) REFERENCES syntheses(id) ON DELETE CASCADE
constraint synthesis_staleness_events.synthesis_staleness_events_pkey p PRIMARY KEY (id)
constraint synthesis_staleness_events.synthesis_staleness_events_synthesis_id_fkey f FOREIGN KEY (synthesis_id) REFERENCES syntheses(id) ON DELETE CASCADE
constraint synthesis_staleness_events.synthesis_staleness_events_trigger_check c CHECK ((trigger = ANY (ARRAY['belief_drift'::text, 'new_contradiction'::text, 'claim_superseded'::text, 'frame_changed'::text, 'edge_revoked'::text])))
index blobs.blobs_pkey CREATE UNIQUE INDEX blobs_pkey ON blobs USING btree (id)
index blobs.idx_blobs_created CREATE INDEX idx_blobs_created ON blobs USING btree (created_at DESC)
index blobs.idx_blobs_hash CREATE INDEX idx_blobs_hash ON blobs USING btree (content_hash)
index blobs.idx_blobs_labels CREATE INDEX idx_blobs_labels ON blobs USING gin (labels)
index blobs.idx_blobs_sample CREATE INDEX idx_blobs_sample ON blobs USING btree (sample_id) WHERE (sample_id IS NOT NULL)
index blobs.idx_blobs_uploader CREATE INDEX idx_blobs_uploader ON blobs USING btree (uploader_id)
index countersignatures.countersignatures_pkey CREATE UNIQUE INDEX countersignatures_pkey ON countersignatures USING btree (id)
index countersignatures.cs_unique_signer_claim CREATE UNIQUE INDEX cs_unique_signer_claim ON countersignatures USING btree (claim_id, signer_id, signature_meaning)
index countersignatures.idx_cs_claim CREATE INDEX idx_cs_claim ON countersignatures USING btree (claim_id)
index countersignatures.idx_cs_created CREATE INDEX idx_cs_created ON countersignatures USING btree (created_at DESC)
index countersignatures.idx_cs_prev_hash CREATE INDEX idx_cs_prev_hash ON countersignatures USING btree (prev_signature_hash) WHERE (prev_signature_hash IS NOT NULL)
index countersignatures.idx_cs_signer CREATE INDEX idx_cs_signer ON countersignatures USING btree (signer_id)
index episcience_worker_state.episcience_worker_state_pkey CREATE UNIQUE INDEX episcience_worker_state_pkey ON episcience_worker_state USING btree (worker_id)
index protocols.idx_protocols_authored_by CREATE INDEX idx_protocols_authored_by ON protocols USING btree (authored_by)
index protocols.idx_protocols_created_at CREATE INDEX idx_protocols_created_at ON protocols USING btree (created_at DESC)
index protocols.idx_protocols_labels CREATE INDEX idx_protocols_labels ON protocols USING gin (labels)
index protocols.idx_protocols_supersedes CREATE INDEX idx_protocols_supersedes ON protocols USING btree (supersedes) WHERE (supersedes IS NOT NULL)
index protocols.idx_protocols_supersedes_version CREATE UNIQUE INDEX idx_protocols_supersedes_version ON protocols USING btree (supersedes, version) WHERE (supersedes IS NOT NULL)
index protocols.protocols_pkey CREATE UNIQUE INDEX protocols_pkey ON protocols USING btree (id)
index sample_claims.idx_sample_claims_claim CREATE INDEX idx_sample_claims_claim ON sample_claims USING btree (claim_id)
index sample_claims.sample_claims_pkey CREATE UNIQUE INDEX sample_claims_pkey ON sample_claims USING btree (sample_id, claim_id)
index samples.idx_samples_created_at CREATE INDEX idx_samples_created_at ON samples USING btree (created_at DESC)
index samples.idx_samples_labels CREATE INDEX idx_samples_labels ON samples USING gin (labels)
index samples.idx_samples_parent CREATE INDEX idx_samples_parent ON samples USING btree (parent_sample_id) WHERE (parent_sample_id IS NOT NULL)
index samples.idx_samples_prepared_by CREATE INDEX idx_samples_prepared_by ON samples USING btree (prepared_by)
index samples.idx_samples_properties CREATE INDEX idx_samples_properties ON samples USING gin (properties)
index samples.idx_samples_status CREATE INDEX idx_samples_status ON samples USING btree (status)
index samples.idx_samples_type CREATE INDEX idx_samples_type ON samples USING btree (sample_type)
index samples.samples_pkey CREATE UNIQUE INDEX samples_pkey ON samples USING btree (id)
index syntheses.syntheses_agent_created_idx CREATE INDEX syntheses_agent_created_idx ON syntheses USING btree (agent_id, created_at DESC)
index syntheses.syntheses_pkey CREATE UNIQUE INDEX syntheses_pkey ON syntheses USING btree (id)
index syntheses.syntheses_stale_idx CREATE INDEX syntheses_stale_idx ON syntheses USING btree (stale_since) WHERE (stale_since IS NOT NULL)
index syntheses.syntheses_status_idx CREATE INDEX syntheses_status_idx ON syntheses USING btree (status) WHERE (status = ANY (ARRAY['pending'::text, 'running'::text]))
index synthesis_claim_membership.synthesis_claim_membership_claim_idx CREATE INDEX synthesis_claim_membership_claim_idx ON synthesis_claim_membership USING btree (claim_id)
index synthesis_claim_membership.synthesis_claim_membership_pkey CREATE UNIQUE INDEX synthesis_claim_membership_pkey ON synthesis_claim_membership USING btree (synthesis_id, claim_id)
index synthesis_claim_membership.synthesis_claim_membership_synthesis_idx CREATE INDEX synthesis_claim_membership_synthesis_idx ON synthesis_claim_membership USING btree (synthesis_id)
index synthesis_clusters.synthesis_clusters_pkey CREATE UNIQUE INDEX synthesis_clusters_pkey ON synthesis_clusters USING btree (id)
index synthesis_clusters.synthesis_clusters_synthesis_id_cluster_index_key CREATE UNIQUE INDEX synthesis_clusters_synthesis_id_cluster_index_key ON synthesis_clusters USING btree (synthesis_id, cluster_index)
index synthesis_clusters.synthesis_clusters_synthesis_idx CREATE INDEX synthesis_clusters_synthesis_idx ON synthesis_clusters USING btree (synthesis_id)
index synthesis_embeddings.synthesis_embeddings_hnsw_idx CREATE INDEX synthesis_embeddings_hnsw_idx ON synthesis_embeddings USING hnsw (embedding vector_cosine_ops)
index synthesis_embeddings.synthesis_embeddings_pkey CREATE UNIQUE INDEX synthesis_embeddings_pkey ON synthesis_embeddings USING btree (synthesis_id)
index synthesis_jobs.synthesis_jobs_pkey CREATE UNIQUE INDEX synthesis_jobs_pkey ON synthesis_jobs USING btree (id)
index synthesis_jobs.synthesis_jobs_state_scheduled_idx CREATE INDEX synthesis_jobs_state_scheduled_idx ON synthesis_jobs USING btree (state, scheduled_at) WHERE (state = ANY (ARRAY['queued'::text, 'retry'::text]))
index synthesis_provo_edges.synthesis_provo_edges_pending_idx CREATE INDEX synthesis_provo_edges_pending_idx ON synthesis_provo_edges USING btree (synthesis_id) WHERE (written_at IS NULL)
index synthesis_provo_edges.synthesis_provo_edges_pkey CREATE UNIQUE INDEX synthesis_provo_edges_pkey ON synthesis_provo_edges USING btree (synthesis_id, predicate, target_kind, target_id)
index synthesis_shares.synthesis_shares_pkey CREATE UNIQUE INDEX synthesis_shares_pkey ON synthesis_shares USING btree (synthesis_id, shared_with_agent_id)
index synthesis_shares.synthesis_shares_recipient_idx CREATE INDEX synthesis_shares_recipient_idx ON synthesis_shares USING btree (shared_with_agent_id)
index synthesis_staleness_events.synthesis_staleness_events_pkey CREATE UNIQUE INDEX synthesis_staleness_events_pkey ON synthesis_staleness_events USING btree (id)
index synthesis_staleness_events.synthesis_staleness_events_synthesis_detected_idx CREATE INDEX synthesis_staleness_events_synthesis_detected_idx ON synthesis_staleness_events USING btree (synthesis_id, detected_at DESC)
table blobs
table countersignatures
table episcience_worker_state
table protocols
table sample_claims
table samples
table syntheses
table synthesis_claim_membership
table synthesis_clusters
table synthesis_embeddings
table synthesis_jobs
table synthesis_provo_edges
table synthesis_shares
table synthesis_staleness_events
trigger protocols.protocols_updated_at CREATE TRIGGER protocols_updated_at BEFORE UPDATE ON protocols FOR EACH ROW EXECUTE FUNCTION update_updated_at_column()
trigger samples.samples_updated_at CREATE TRIGGER samples_updated_at BEFORE UPDATE ON samples FOR EACH ROW EXECUTE FUNCTION update_updated_at_column()
