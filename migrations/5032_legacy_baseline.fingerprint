column synthesis_clusters.member_claim_ids #6 uuid[] not-null default=-
column synthesis_clusters.summary #5 text not-null default=-
column synthesis_clusters.support_count #7 integer not-null default=-
column synthesis_clusters.synthesis_id #2 uuid not-null default=-
column synthesis_clusters.title #4 text not-null default=-
column synthesis_embeddings.created_at #5 timestamp with time zone not-null default=now()
column synthesis_embeddings.embedding #2 vector(1536) not-null default=-
column synthesis_embeddings.embedding_input #4 text not-null default=-
column synthesis_embeddings.embedding_model #3 text not-null default=-
column synthesis_embeddings.synthesis_id #1 uuid not-null default=-
column synthesis_jobs.attempts #5 integer not-null default=0
column synthesis_jobs.completed_at #9 timestamp with time zone nullable default=-
column synthesis_jobs.created_at #11 timestamp with time zone not-null default=now()
column synthesis_jobs.id #1 uuid not-null default=-
column synthesis_jobs.job_type #2 text not-null default='synthesis'::text
column synthesis_jobs.last_error #10 text nullable default=-
